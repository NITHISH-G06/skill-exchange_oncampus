# Sri Eshwar College of Engineering - Campus Skill Exchange
# Environment Configuration Template
# Copy this file to .env and configure values if integrating real services.

# Application Settings
APP_ENV=development
APP_SECRET_KEY=change-this-in-production-to-a-secure-random-key
DATABASE_PATH=campus_skill_exchange.db

# College Information
COLLEGE_NAME=SRI ESHWAR COLLEGE OF ENGINEERING
COLLEGE_DOMAIN=sece.ac.in

# Google Calendar & Google Meet Integration (Optional)
# If left empty, the application will automatically run in clearly labeled [DEMO MODE]
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:8501/oauth2callback
GOOGLE_REFRESH_TOKEN=optional-refresh-token-here

# Platform Commission Settings (Revenue Simulation)
PLATFORM_COMMISSION_PERCENT=10.0
